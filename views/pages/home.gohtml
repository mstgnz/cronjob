{{template "base" . }}

{{define "content"}}

<div class="container mt-4">

  <p class="text-muted">Dashboard Overview</p>
  
  <div class="row mb-4">
    <div class="col-md-12">
      <div class="card">
        <div class="card-header">
          <h5 class="card-title mb-0">Statistics Overview</h5>
        </div>
        <div class="card-body">
          <canvas id="myChart" height="80"></canvas>
        </div>
      </div>
    </div>
  </div>

  <div class="row mb-4">
    <div class="col-md-12">
      <div class="card">
        <div class="card-header">
          <h5 class="card-title mb-0">Schedule Logs - Last 7 Days</h5>
        </div>
        <div class="card-body">
          <canvas id="lineChart" height="80"></canvas>
        </div>
      </div>
    </div>
  </div>

</div>

{{end}}

{{ define "js" }}
<script>
  const ctx = document.getElementById('myChart');

  // Get statistics from server
  const stats = {
    schedules: {{or .schedules 0}},
    groups: {{or .groups 0}},
    notifications: {{or .notifications 0}},
    requests: {{or .requests 0}},
    webhooks: {{or .webhooks 0}},
    logs: {{or .logs 0}}
  };

  // Bar Chart
  new Chart(ctx, {
    type: 'bar',
    data: {
      labels: ['Schedules', 'Groups', 'Notifications', 'Requests', 'Webhooks', 'Logs'],
      datasets: [{
        label: 'Count',
        data: [
          stats.schedules,
          stats.groups,
          stats.notifications,
          stats.requests,
          stats.webhooks,
          stats.logs
        ],
        backgroundColor: [
          'rgba(54, 162, 235, 0.6)',
          'rgba(75, 192, 192, 0.6)',
          'rgba(255, 206, 86, 0.6)',
          'rgba(153, 102, 255, 0.6)',
          'rgba(255, 159, 64, 0.6)',
          'rgba(199, 199, 199, 0.6)'
        ],
        borderColor: [
          'rgba(54, 162, 235, 1)',
          'rgba(75, 192, 192, 1)',
          'rgba(255, 206, 86, 1)',
          'rgba(153, 102, 255, 1)',
          'rgba(255, 159, 64, 1)',
          'rgba(199, 199, 199, 1)'
        ],
        borderWidth: 2
      }]
    },
    options: {
      responsive: true,
      maintainAspectRatio: true,
      plugins: {
        legend: {
          display: false
        },
        tooltip: {
          callbacks: {
            label: function(context) {
              return context.label + ': ' + context.parsed.y;
            }
          }
        }
      },
      scales: {
        y: {
          beginAtZero: true,
          ticks: {
            stepSize: 1
          }
        }
      }
    }
  });

  // Line Chart for Daily Logs
  const lineCtx = document.getElementById('lineChart');
  const dailyLogs = JSON.parse({{if .dailyLogsJSON}}'{{.dailyLogsJSON}}'{{else}}'{}'{{end}});
  
  // Generate last 7 days labels
  const labels = [];
  const data = [];
  const today = new Date();
  
  for (let i = 6; i >= 0; i--) {
    const date = new Date(today);
    date.setDate(date.getDate() - i);
    const dateStr = date.toISOString().split('T')[0];
    labels.push(dateStr);
    data.push(dailyLogs[dateStr] || 0);
  }

  new Chart(lineCtx, {
    type: 'line',
    data: {
      labels: labels,
      datasets: [{
        label: 'Schedule Logs',
        data: data,
        borderColor: 'rgba(54, 162, 235, 1)',
        backgroundColor: 'rgba(54, 162, 235, 0.1)',
        borderWidth: 2,
        fill: true,
        tension: 0.4,
        pointRadius: 4,
        pointHoverRadius: 6,
        pointBackgroundColor: 'rgba(54, 162, 235, 1)',
        pointBorderColor: '#fff',
        pointBorderWidth: 2
      }]
    },
    options: {
      responsive: true,
      maintainAspectRatio: true,
      plugins: {
        legend: {
          display: true,
          position: 'top'
        },
        tooltip: {
          callbacks: {
            label: function(context) {
              return 'Logs: ' + context.parsed.y;
            }
          }
        }
      },
      scales: {
        y: {
          beginAtZero: true,
          ticks: {
            stepSize: 1
          }
        },
        x: {
          title: {
            display: true,
            text: 'Date'
          }
        }
      }
    }
  });
</script>
{{end}}