{{template "base" . }}

{{define "scheduleNew" }}
<div class="row justify-content-center mt-2">
    <div class="col-8">
        <form hx-post="/schedules" hx-target="#toast" hx-swap="innerHTML" hx-ext="json-enc" novalidate autocomplete="off">
            <div class="input-group mb-3">
                <div class="form-floating flex-grow-1">
                    <select class="form-select" name="group_id" id="group_id" required hx-get="/requests" hx-target="#request_id" hx-swap="innerHTML" hx-trigger="change" hx-include="[name='group_id']">
                        <option value="0" selected>Choose Group</option>
                        {{ range .groups.groups }}
                        <option value="{{.ID}}">{{.Name}}</option>
                        {{end}}
                    </select>
                    <label for="group_id">Group</label>
                </div>
                <button class="btn btn-primary h-100" type="button" onclick="openGroupModal()">New</button>
            </div>
            <div class="input-group mb-3">
                <div class="form-floating flex-grow-1">
                    <!-- get request from group id -->
                    <select class="form-select" name="request_id" required id="request_id">
                        <option value="0" selected disabled>Choose Request</option>
                    </select>
                    <label for="request_id">Request</label>
                </div>
                <button class="btn btn-primary h-100" type="button" onclick="openRequestModal()">New</button>
            </div>
            <div class="input-group mb-3">
                <div class="form-floating flex-grow-1">
                    <select class="form-select" name="notification_id" id="notification_id" required>
                        <option value="0" selected>Choose Notification</option>
                        {{ range .notifications.notifications }}
                        <option value="{{.ID}}">{{.Title}}</option>
                        {{end}}
                    </select>
                    <label for="notification_id">Notification</label>
                </div>
                <button class="btn btn-primary h-100" type="button" onclick="openNotificationModal()">New</button>
            </div>
            <div class="form-floating mb-2">
                <input type="text" class="form-control" name="timing" placeholder="timing" required>
                <label for="timing">Timing (Example: 0 0 * * *)</label>
            </div>
            <div class="form-floating mb-2">
                <input type="number" class="form-control" name="timeout" placeholder="timeout" required>
                <label for="timeout">Timeout (seconds)</label>
            </div>
            <div class="form-floating mb-2">
                <input type="number" class="form-control" name="retries" placeholder="retries" required>
                <label for="retries">Retries</label>
            </div>
            <div class="form-floating mb-2">
                <select class="form-select" name="active">
                    <option value="true" selected>Active</option>
                    <option value="false">Deactive</option>
                </select>
                <label for="active">Status</label>
            </div>
            <button type="submit" class="btn btn-primary w-100 py-2 mb-1">Schedule Save</button>
        </form>
    </div>
</div>

<!-- Group Modal -->
<div class="modal fade" id="groupModal" tabindex="-1" aria-labelledby="groupModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="groupModalLabel">New Group</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="groupModalForm" hx-post="/groups/modal" hx-target="#groupModalResponse" hx-swap="innerHTML" hx-ext="json-enc" hx-on::htmx:after-request="handleGroupCreated(event)">
                <div class="modal-body">
                    <div id="groupModalResponse"></div>
                    <div class="form-floating mb-2">
                        <input type="text" class="form-control" name="name" placeholder="Name" required>
                        <label for="name">Name</label>
                    </div>
                    <div class="form-floating mb-2">
                        <select class="form-select" name="uid">
                            <option value="0" selected>Choose Parent (optional)</option>
                            {{ range .groups.groups }}
                            <option value="{{.ID}}">{{.Name}}</option>
                            {{end}}
                        </select>
                        <label for="uid">Parent</label>
                    </div>
                    <div class="form-floating mb-2">
                        <select class="form-select" name="active">
                            <option value="true" selected>Active</option>
                            <option value="false">Deactive</option>
                        </select>
                        <label for="active">Status</label>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                    <button type="submit" class="btn btn-primary">Save Group</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Request Modal -->
<div class="modal fade" id="requestModal" tabindex="-1" aria-labelledby="requestModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="requestModalLabel">New Request</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="requestModalForm" hx-post="/requests/modal" hx-target="#requestModalResponse" hx-swap="innerHTML" hx-ext="json-enc" hx-on::htmx:before-request="prepareRequestForm(event)" hx-on::htmx:after-request="handleRequestCreated(event)">
                <div class="modal-body">
                    <div id="requestModalResponse"></div>
                    <!-- Hidden input for group_id when select is disabled -->
                    <input type="hidden" name="group_id" id="requestModalGroupIdHidden">
                    <div class="form-floating mb-2">
                        <select class="form-select" id="requestModalGroupId" required>
                            <option value="0" selected>Choose Group</option>
                            {{ range .groups.groups }}
                            <option value="{{.ID}}">{{.Name}}</option>
                            {{end}}
                        </select>
                        <label for="requestModalGroupId">Group</label>
                    </div>
                    <div class="form-floating mb-2">
                        <input type="text" class="form-control" name="url" placeholder="Url" required>
                        <label for="url">Url</label>
                    </div>
                    <div class="form-floating mb-2">
                        <select class="form-select" name="method">
                            <option value="GET" selected>GET</option>
                            <option value="POST">POST</option>
                            <option value="PUT">PUT</option>
                            <option value="PATCH">PATCH</option>
                            <option value="DELETE">DELETE</option>
                        </select>
                        <label for="method">Method</label>
                    </div>
                    <div class="form-floating mb-2">
                        <textarea class="form-control" name="content" placeholder="Content" style="height: 100px"></textarea>
                        <label for="content">Content (only JSON format) (optional)</label>
                    </div>
                    <div class="form-floating mb-2">
                        <select class="form-select" name="active">
                            <option value="true" selected>Active</option>
                            <option value="false">Deactive</option>
                        </select>
                        <label for="active">Status</label>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                    <button type="submit" class="btn btn-primary">Save Request</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Notification Modal -->
<div class="modal fade" id="notificationModal" tabindex="-1" aria-labelledby="notificationModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="notificationModalLabel">New Notification</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="notificationModalForm" hx-post="/notifications/modal" hx-target="#notificationModalResponse" hx-swap="innerHTML" hx-ext="json-enc" hx-on::htmx:after-request="handleNotificationCreated(event)">
                <div class="modal-body">
                    <div id="notificationModalResponse"></div>
                    <div class="form-floating mb-2">
                        <input type="text" class="form-control" name="title" placeholder="title" required>
                        <label for="title">Title</label>
                    </div>
                    <div class="form-floating mb-2">
                        <input type="text" class="form-control" name="content" placeholder="content" required>
                        <label for="content">Content</label>
                    </div>
                    <div class="form-floating mb-2">
                        <select class="form-select" name="is_mail">
                            <option value="true" selected>Active</option>
                            <option value="false">Deactive</option>
                        </select>
                        <label for="is_mail">Is Mail</label>
                    </div>
                    <div class="form-floating mb-2">
                        <select class="form-select" name="is_message">
                            <option value="true" selected>Active</option>
                            <option value="false">Deactive</option>
                        </select>
                        <label for="is_message">Is Message</label>
                    </div>
                    <div class="form-floating mb-2">
                        <select class="form-select" name="active">
                            <option value="true" selected>Active</option>
                            <option value="false">Deactive</option>
                        </select>
                        <label for="active">Status</label>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                    <button type="submit" class="btn btn-primary">Save Notification</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script>
// Functions to open modals
function openGroupModal() {
    const modalElement = document.getElementById('groupModal');
    if (modalElement) {
        const modal = new bootstrap.Modal(modalElement);
        modal.show();
    }
}

function openRequestModal() {
    const modalElement = document.getElementById('requestModal');
    if (modalElement) {
        // Get selected group from main form
        const groupSelect = document.getElementById('group_id');
        const requestModalGroupId = document.getElementById('requestModalGroupId');
        
        if (groupSelect && requestModalGroupId) {
            // Find the selected option (check selected attribute first, then selectedIndex)
            let selectedGroupId = null;
            const selectedOptionByAttr = groupSelect.querySelector('option[selected]');
            if (selectedOptionByAttr && selectedOptionByAttr.value && selectedOptionByAttr.value !== '0' && selectedOptionByAttr.value !== 'new') {
                selectedGroupId = selectedOptionByAttr.value;
            } else {
                // Check selectedIndex
                const selectedIndex = groupSelect.selectedIndex;
                if (selectedIndex > 0) {
                    const selectedOption = groupSelect.options[selectedIndex];
                    if (selectedOption && selectedOption.value && selectedOption.value !== '0' && selectedOption.value !== 'new') {
                        selectedGroupId = selectedOption.value;
                    }
                }
                // Fallback to .value property
                if (!selectedGroupId && groupSelect.value && groupSelect.value !== '0' && groupSelect.value !== 'new') {
                    selectedGroupId = groupSelect.value;
                }
            }
            
            if (selectedGroupId) {
                // Make sure the option exists in request modal's group select
                const optionExists = requestModalGroupId.querySelector(`option[value="${selectedGroupId}"]`);
                if (optionExists) {
                    // Set the group in request modal and disable it
                    requestModalGroupId.value = selectedGroupId;
                    requestModalGroupId.disabled = true;
                    // Also set the hidden input
                    const hiddenInput = document.getElementById('requestModalGroupIdHidden');
                    if (hiddenInput) {
                        hiddenInput.value = selectedGroupId;
                    }
                } else {
                    // Option doesn't exist yet, we need to add it first
                    // This can happen if group was just created
                    // Try to find it in the main form's group select and copy it
                    const mainFormOption = groupSelect.querySelector(`option[value="${selectedGroupId}"]`);
                    if (mainFormOption) {
                        const newOption = document.createElement('option');
                        newOption.value = mainFormOption.value;
                        newOption.textContent = mainFormOption.textContent;
                        // Insert after the first option
                        const firstOption = requestModalGroupId.querySelector('option[value="0"]');
                        if (firstOption && firstOption.nextSibling) {
                            requestModalGroupId.insertBefore(newOption, firstOption.nextSibling);
                        } else {
                            requestModalGroupId.appendChild(newOption);
                        }
                        requestModalGroupId.value = selectedGroupId;
                        requestModalGroupId.disabled = true;
                        // Also set the hidden input
                        const hiddenInput = document.getElementById('requestModalGroupIdHidden');
                        if (hiddenInput) {
                            hiddenInput.value = selectedGroupId;
                        }
                    } else {
                        // Can't find the option, enable and let user select
                        requestModalGroupId.value = '0';
                        requestModalGroupId.disabled = false;
                        const hiddenInput = document.getElementById('requestModalGroupIdHidden');
                        if (hiddenInput) {
                            hiddenInput.value = '';
                        }
                    }
                }
            } else {
                // If no group selected, enable and reset
                requestModalGroupId.value = '0';
                requestModalGroupId.disabled = false;
                const hiddenInput = document.getElementById('requestModalGroupIdHidden');
                if (hiddenInput) {
                    hiddenInput.value = '';
                }
            }
            
            // Always ensure hidden input is set before modal opens
            const hiddenInput = document.getElementById('requestModalGroupIdHidden');
            if (hiddenInput && requestModalGroupId && requestModalGroupId.value && requestModalGroupId.value !== '0') {
                hiddenInput.value = requestModalGroupId.value;
            }
        }
        
        const modal = new bootstrap.Modal(modalElement);
        modal.show();
    }
}

function openNotificationModal() {
    const modalElement = document.getElementById('notificationModal');
    if (modalElement) {
        const modal = new bootstrap.Modal(modalElement);
        modal.show();
    }
}

// Reset request modal when closed
function resetRequestModal() {
    const requestModalGroupId = document.getElementById('requestModalGroupId');
    const hiddenInput = document.getElementById('requestModalGroupIdHidden');
    if (requestModalGroupId) {
        requestModalGroupId.disabled = false;
        requestModalGroupId.value = '0';
    }
    if (hiddenInput) {
        hiddenInput.value = '';
    }
}

// Prepare request form before submit - ensure group_id is sent even if disabled
function prepareRequestForm(event) {
    const requestModalGroupId = document.getElementById('requestModalGroupId');
    const hiddenInput = document.getElementById('requestModalGroupIdHidden');
    
    if (requestModalGroupId && hiddenInput) {
        const groupId = requestModalGroupId.value;
        
        // Always set hidden input with the current value (whether disabled or not)
        if (groupId && groupId !== '0' && groupId !== 'new') {
            hiddenInput.value = groupId;
        } else {
            hiddenInput.value = '';
        }
    }
}

// Listen for modal close events
document.addEventListener('DOMContentLoaded', function() {
    const requestModal = document.getElementById('requestModal');
    if (requestModal) {
        requestModal.addEventListener('hidden.bs.modal', function() {
            resetRequestModal();
        });
    }
});

// Listen for HTMX events globally as backup
document.body.addEventListener('htmx:after-request', function(event) {
    const elt = event.detail.elt;
    const xhr = event.detail.xhr;
    
    // Check if this is a modal form submission
    if (elt && elt.id) {
        if (elt.id === 'requestModalForm' && xhr.status === 201) {
            handleRequestCreated(event);
        } else if (elt.id === 'groupModalForm' && xhr.status === 201) {
            handleGroupCreated(event);
        } else if (elt.id === 'notificationModalForm' && xhr.status === 201) {
            handleNotificationCreated(event);
        }
    }
});

// Handle select change for "new" option
document.addEventListener('DOMContentLoaded', function() {
    const groupSelect = document.getElementById('group_id');
    const requestSelect = document.getElementById('request_id');
    const notificationSelect = document.getElementById('notification_id');
    const webhookGroupSelect = document.getElementById('webhook_group_id');
    const webhookRequestSelect = document.getElementById('webhook_request_id');
    
    // Group select handler
    if (groupSelect) {
        groupSelect.addEventListener('change', function() {
            if (this.value === 'new') {
                openGroupModal();
                this.value = '0';
            }
        });
    }
    
    // Request select handler
    if (requestSelect) {
        requestSelect.addEventListener('change', function() {
            if (this.value === 'new') {
                openRequestModal();
                this.value = '0';
            }
        });
    }
    
    // Notification select handler
    if (notificationSelect) {
        notificationSelect.addEventListener('change', function() {
            if (this.value === 'new') {
                openNotificationModal();
                this.value = '0';
            }
        });
    }
    
    // Webhook Group select handler
    if (webhookGroupSelect) {
        webhookGroupSelect.addEventListener('change', function() {
            if (this.value === 'new') {
                openGroupModal();
                this.value = '0';
            }
        });
    }
    
    // Webhook Request select handler
    if (webhookRequestSelect) {
        webhookRequestSelect.addEventListener('change', function() {
            if (this.value === 'new') {
                openRequestModal();
                this.value = '0';
            }
        });
    }
});

// Handle group created
function handleGroupCreated(event) {
    const xhr = event.detail.xhr;
    const status = xhr.status;
    
    if (status === 201) {
        try {
            const response = JSON.parse(xhr.responseText);
            if (response.status && response.data && response.data.group) {
                const group = response.data.group;
                const groupSelect = document.getElementById('group_id');
                const requestModalGroupId = document.getElementById('requestModalGroupId');
                
                if (groupSelect) {
                    // Check if option already exists
                    const existingOption = groupSelect.querySelector(`option[value="${group.id}"]`);
                    if (!existingOption) {
                        const option = document.createElement('option');
                        option.value = group.id;
                        option.textContent = group.name;
                        option.selected = true;
                        // Insert after the first option (Choose Group)
                        const firstOption = groupSelect.querySelector('option[value="0"]');
                        if (firstOption && firstOption.nextSibling) {
                            groupSelect.insertBefore(option, firstOption.nextSibling);
                        } else {
                            groupSelect.appendChild(option);
                        }
                    } else {
                        existingOption.selected = true;
                    }
                    
                    // Also update request modal's group select if it exists
                    if (requestModalGroupId) {
                        // Check if option already exists in request modal
                        const existingRequestModalOption = requestModalGroupId.querySelector(`option[value="${group.id}"]`);
                        if (!existingRequestModalOption) {
                            const requestModalOption = document.createElement('option');
                            requestModalOption.value = group.id;
                            requestModalOption.textContent = group.name;
                            // Insert after the first option
                            const firstRequestModalOption = requestModalGroupId.querySelector('option[value="0"]');
                            if (firstRequestModalOption && firstRequestModalOption.nextSibling) {
                                requestModalGroupId.insertBefore(requestModalOption, firstRequestModalOption.nextSibling);
                            } else {
                                requestModalGroupId.appendChild(requestModalOption);
                            }
                        }
                        // If request modal is open and group is disabled, update hidden input too
                        const requestModal = document.getElementById('requestModal');
                        if (requestModal && requestModal.classList.contains('show') && requestModalGroupId.disabled) {
                            const hiddenInput = document.getElementById('requestModalGroupIdHidden');
                            if (hiddenInput && requestModalGroupId.value === group.id.toString()) {
                                hiddenInput.value = group.id;
                            }
                        }
                    }
                    
                    // Trigger change event to update request select
                    groupSelect.dispatchEvent(new Event('change'));
                }
                
                // Close modal
                const modalElement = document.getElementById('groupModal');
                if (modalElement) {
                    const modal = bootstrap.Modal.getInstance(modalElement);
                    if (modal) modal.hide();
                }
                
                // Clear form
                const form = document.getElementById('groupModalForm');
                if (form) form.reset();
            }
        } catch (e) {
            console.error('Error parsing group response:', e);
        }
    }
}

// Handle request created
function handleRequestCreated(event) {
    const xhr = event.detail.xhr;
    const status = xhr.status;
    
    if (status === 201) {
        try {
            const response = JSON.parse(xhr.responseText);
            if (response.status && response.data && response.data.request) {
                const request = response.data.request;
                const requestSelect = document.getElementById('request_id');
                
                if (requestSelect) {
                    // Check if option already exists
                    const existingOption = requestSelect.querySelector(`option[value="${request.id}"]`);
                    if (!existingOption) {
                        const option = document.createElement('option');
                        option.value = request.id;
                        option.textContent = request.url;
                        option.selected = true;
                        // Remove disabled from first option and add new option
                        const firstOption = requestSelect.querySelector('option[value="0"]');
                        if (firstOption) {
                            firstOption.disabled = false;
                        }
                        requestSelect.appendChild(option);
                        option.selected = true;
                    } else {
                        existingOption.selected = true;
                    }
                    
                    // Also update group select if it's not already selected
                    const groupSelect = document.getElementById('group_id');
                    const requestModalGroupId = document.getElementById('requestModalGroupId');
                    if (groupSelect && requestModalGroupId && requestModalGroupId.value !== '0') {
                        if (groupSelect.value !== requestModalGroupId.value) {
                            groupSelect.value = requestModalGroupId.value;
                            groupSelect.dispatchEvent(new Event('change'));
                        }
                    }
                }
                
                // Close modal
                const modalElement = document.getElementById('requestModal');
                if (modalElement) {
                    const modal = bootstrap.Modal.getInstance(modalElement);
                    if (modal) modal.hide();
                }
                
                // Clear form
                const form = document.getElementById('requestModalForm');
                if (form) {
                    form.reset();
                }
                
                // Reset modal state
                resetRequestModal();
            }
        } catch (e) {
            console.error('Error parsing request response:', e);
        }
    }
}

// Handle notification created
function handleNotificationCreated(event) {
    const xhr = event.detail.xhr;
    const status = xhr.status;
    
    if (status === 201) {
        try {
            const response = JSON.parse(xhr.responseText);
            if (response.status && response.data && response.data.notification) {
                const notification = response.data.notification;
                const notificationSelect = document.getElementById('notification_id');
                
                if (notificationSelect) {
                    // Check if option already exists
                    const existingOption = notificationSelect.querySelector(`option[value="${notification.id}"]`);
                    if (!existingOption) {
                        const option = document.createElement('option');
                        option.value = notification.id;
                        option.textContent = notification.title;
                        option.selected = true;
                        // Insert after the first option (Choose Notification)
                        const firstOption = notificationSelect.querySelector('option[value="0"]');
                        if (firstOption && firstOption.nextSibling) {
                            notificationSelect.insertBefore(option, firstOption.nextSibling);
                        } else {
                            notificationSelect.appendChild(option);
                        }
                    } else {
                        existingOption.selected = true;
                    }
                }
                
                // Close modal
                const modalElement = document.getElementById('notificationModal');
                if (modalElement) {
                    const modal = bootstrap.Modal.getInstance(modalElement);
                    if (modal) modal.hide();
                }
                
                // Clear form
                const form = document.getElementById('notificationModalForm');
                if (form) form.reset();
            }
        } catch (e) {
            console.error('Error parsing notification response:', e);
        }
    }
}
</script>
{{end}}