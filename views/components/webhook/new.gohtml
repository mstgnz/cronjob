{{template "base" . }}

{{define "webhookNew" }}

<div class="row">
    <div class="col-6 mt-2">
        <form hx-post="/webhooks" hx-target="#toast" hx-swap="innerHTML" hx-ext="json-enc" novalidate autocomplete="off">
            <div class="form-floating mb-2">
                <select class="form-select" name="group_id" required hx-get="/requests{{.group_id}}" hx-target="#request_id" hx-swap="innerHTML">
                    <option value="0" selected>Choose Group</option>
                    {{ range .groups.groups }}
                    <option value="{{.ID}}">{{.Name}}</option>
                    {{end}}
                </select>
                <label for="group_id">Group</label>
            </div>
            <div class="form-floating mb-2">
                <!-- get request from group id -->
                <select class="form-select" name="request_id" required id="request_id">
                    <option value="0" selected disabled>Choose Request</option>
                </select>
                <label for="request_id">Request</label>
            </div>
            <div class="form-floating mb-2">
                <select class="form-select" name="schedule_id" required>
                    <option value="0" selected disabled>Choose Schedule</option>
                    {{ range .schedules.schedules }}
                    <option value="{{.ID}}">{{.Timing}} - {{.Request.Url}}</option>
                    {{end}}
                </select>
                <label for="schedule_id">Schedule</label>
            </div>
            <div class="form-floating mb-2">
                <select class="form-select" name="active">
                    <option value="true" selected>Active</option>
                    <option value="false">Deactive</option>
                </select>
                <label for="active">Status</label>
            </div>
            <button type="submit" class="btn btn-primary w-100 py-2 mb-1">Webhook Save</button>
        </form>
    </div>
</div>

{{end}}